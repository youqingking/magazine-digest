    "art_rd_12112025_011|zh-CN|teen|quick_30s": {
      "article": {
        "article_id": "art_rd_12112025_011",
        "article_key": "real_rd_12112025_011",
        "title": "梦幻庆典：圣诞季的魔力时刻",
        "original_title": "Magisches Fest (Magical Celebration)",
        "summary": "圣诞魔力的本质在于**非物质性的社会协作与共情驱动**。通过联合航空（United Airlines）为患病儿童打造的“北极幻想航班”、邻里间跨越社交平台的零成本资源共享（键盘捐赠），以及跨文化背景下（犹太教与基督教）对节日温情的再定义，文章揭示了节日作为**社会情绪粘合剂**的",
        "publication_key": "readers_digest",
        "publication_name": "Reader's Digest",
        "section_label": "本期文章 (Articles)",
        "start_page": 84,
        "canonical_url": null,
        "cover": null,
        "author": null
      },
      "resolved_variant": {
        "article_variant_id": "var_art_rd_12112025_011_teen_quick_30s",
        "audience_segment": "teen",
        "reading_mode": "quick_30s",
        "revision": 1,
        "title": "梦幻庆典：圣诞季的魔力时刻",
        "markdown_body": "想去北极看圣诞老人吗？有一架波音 777 客机真的能带你去！在飞机上，机长会让你拉下遮光帘，当你再次睁眼时，飞机已经降落在了一个铺满棉花雪花和满是玩具的“北极乐园” 。还有一位老爷爷在深夜送出了一台真正的钢琴，只为了让一个小女孩在圣诞清晨能够弹响音符。这就是现实世界里的“魔法” 。",
        "content_hash": "265965b4be423ed9aecb50a1bbb4f0ae2d458d4c",
        "premium_tier": "premium",
        "publish_batch_id": "batch_readers_digest_12112025",
        "update_type": "new_publish",
        "update_priority": 80,
        "change_summary": "12112025 真实样本导入",
        "notify_level": "default",
        "is_breaking": false,
        "available_from": "2025-12-11T09:00:00+08:00",
        "available_until": null,
        "source_field": "teen_quick_30s"
      },
      "selection_reason": "exact_match",
      "fallback_applied": false,
