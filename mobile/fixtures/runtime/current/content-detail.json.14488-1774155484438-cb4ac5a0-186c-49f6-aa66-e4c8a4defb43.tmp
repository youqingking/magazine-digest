    "art_rd_12112025_003|zh-CN|general|quick_30s": {
      "article": {
        "article_id": "art_rd_12112025_003",
        "article_key": "real_rd_12112025_003",
        "title": "消失的数百万美金",
        "original_title": "Die Millionen sind weg!",
        "summary": "这是一场发生在熟人社会中的**金融信用坍塌**。美国堪萨斯州哈特兰三州银行（Heartland Tri-State Bank）前行长单·海恩斯（Shan Hanes），因陷入被称为“杀猪盘”（Pig Butchering）的加密货币骗局，利用职务之便挪用约4710万美元资金。该案",
        "publication_key": "readers_digest",
        "publication_name": "Reader's Digest",
        "section_label": "本期文章 (Articles)",
        "start_page": 38,
        "canonical_url": null,
        "cover": null,
        "author": null
      },
      "resolved_variant": {
        "article_variant_id": "var_art_rd_12112025_003_general_quick_30s",
        "audience_segment": "general",
        "reading_mode": "quick_30s",
        "revision": 1,
        "title": "消失的数百万美金",
        "markdown_body": "这是一场发生在熟人社会中的**金融信用坍塌**。美国堪萨斯州哈特兰三州银行（Heartland Tri-State Bank）前行长单·海恩斯（Shan Hanes），因陷入被称为“杀猪盘”（Pig Butchering）的加密货币骗局，利用职务之便挪用约4710万美元资金。该案导致这家拥有40年历史的小镇银行破产倒闭 。海恩斯最终被判处24年零5个月监禁。此案警示：在高透明度的现代金融体系中，**“基于人情的内部审计真空”**是机构最大的生存威胁 。",
        "content_hash": "d4c5be7a9f65eee628e7250e34c73421e25f7c25",
        "premium_tier": "free",
        "publish_batch_id": "batch_readers_digest_12112025",
        "update_type": "new_publish",
        "update_priority": 80,
        "change_summary": "12112025 真实样本导入",
        "notify_level": "default",
