    "art_rd_12112025_001|zh-CN|teen|quick_30s": {
      "article": {
        "article_id": "art_rd_12112025_001",
        "article_key": "real_rd_12112025_001",
        "title": "23项冬季生活锦囊",
        "original_title": "23 Winter-Tipps",
        "summary": "冬季效能优化的核心在于**生物钟管理**与**精力精算**：通过清晨光照调节昼夜节律以维持工作状态 ；利用“社交减法”拒绝低质量聚会以防倦怠 ；在饮食中加入姜黄等抗炎香料 ；并采用“羊毛+抓绒”的专业分层穿衣法维持体温平衡 。",
        "publication_key": "readers_digest",
        "publication_name": "Reader's Digest",
        "section_label": "封面故事 (Cover Story)",
        "start_page": 30,
        "canonical_url": null,
        "cover": null,
        "author": null
      },
      "resolved_variant": {
        "article_variant_id": "var_art_rd_12112025_001_teen_quick_30s",
        "audience_segment": "teen",
        "reading_mode": "quick_30s",
        "revision": 1,
        "title": "23项冬季生活锦囊",
        "markdown_body": "你知道吗？萨米族人的一年有8个季节，而冬天其实可以被拆成三部分，这样你就不会觉得它太漫长了 ！想快速暖和起来？像大风车一样转动你的手臂，离心力会让血液迅速流向指尖 。还有，跳泥坑不仅好玩，户外活动还能让你晚上睡得更香 。",
        "content_hash": "0b08dea4d90c426384a0c4b8f94612905cb88c55",
        "premium_tier": "free",
        "publish_batch_id": "batch_readers_digest_12112025",
        "update_type": "new_publish",
        "update_priority": 80,
        "change_summary": "12112025 真实样本导入",
