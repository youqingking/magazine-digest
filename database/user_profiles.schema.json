{
  "collection": "user_profiles",
  "version": "stage-h0-2026-03-18",
  "scope": "global",
  "write_model": "master_data",
  "required": ["_id", "phone", "auth_state", "consent_accepted", "created_at", "updated_at"],
  "properties": {
    "_id": { "type": "string" },
    "phone": { "type": "string" },
    "auth_state": { "type": "string", "enum": ["anonymous", "verified", "disabled"] },
    "consent_accepted": { "type": "boolean" },
    "consent_accepted_at": { "type": "string", "format": "date-time" },
    "display_name": { "type": "string" },
    "auth_provider": { "type": "string" },
    "auth_subject_id": { "type": "string" },
    "session_state": { "type": "string", "enum": ["anonymous", "active", "refreshing", "signed_out", "disabled", "remote_stubbed"] },
    "last_session_id": { "type": "string" },
    "last_signin_at": { "type": "string", "format": "date-time" },
    "last_signout_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "indexes": [
    { "name": "uk_phone", "fields": ["phone"], "unique": true },
    { "name": "idx_auth_state", "fields": ["auth_state", "updated_at"] }
  ]
}
