    "third_party": "Google AdMob",
    "data_categories": ["Device or other IDs", "App activity"],
    "risk": "ads_tracking_candidate"
  },
  "appsflyer": {
    "patterns": ["appsflyer", "react-native-appsflyer"],
    "category": "attribution",
    "third_party": "AppsFlyer",
    "data_categories": ["Device or other IDs", "App activity"],
    "risk": "tracking_candidate"
  },
  "adjust": {
    "patterns": ["adjust", "react-native-adjust"],
    "category": "attribution",
    "third_party": "Adjust",
    "data_categories": ["Device or other IDs", "App activity"],
    "risk": "tracking_candidate"
  },
  "amplitude": {
    "patterns": ["amplitude", "@amplitude/analytics-react-native", "@amplitude/analytics-browser"],
    "category": "analytics",
    "third_party": "Amplitude",
    "data_categories": ["App activity", "Device or other IDs"],
    "risk": "analytics"
  },
  "mixpanel": {
    "patterns": ["mixpanel", "mixpanel-react-native"],
    "category": "analytics",
    "third_party": "Mixpanel",
    "data_categories": ["App activity", "Device or other IDs"],
    "risk": "analytics"
  },
  "segment": {
    "patterns": ["segment", "@segment/analytics-react-native", "analytics-react-native"],
    "category": "analytics",
    "third_party": "Segment",
    "data_categories": ["App activity", "Device or other IDs"],
    "risk": "analytics"
  },
  "posthog": {
    "patterns": ["posthog", "posthog-react-native", "posthog-js"],
    "category": "analytics",
    "third_party": "PostHog",
    "data_categories": ["App activity", "Device or other IDs"],
    "risk": "analytics"
  },
  "supabase": {
    "patterns": ["supabase", "@supabase/supabase-js"],
    "category": "database_backend",
    "third_party": "Supabase",
    "data_categories": ["Personal info", "App activity"],
    "risk": "backend_or_auth"
