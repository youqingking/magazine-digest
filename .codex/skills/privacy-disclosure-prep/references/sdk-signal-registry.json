{
  "firebase": {
    "patterns": ["firebase", "@react-native-firebase/app", "@react-native-firebase/analytics", "firebase-analytics"],
    "category": "analytics",
    "third_party": "Google Firebase",
    "data_categories": ["App activity", "Device or other IDs"],
    "risk": "analytics_or_crash"
  },
  "crashlytics": {
    "patterns": ["crashlytics", "@react-native-firebase/crashlytics"],
    "category": "crash_reporting",
    "third_party": "Google Firebase Crashlytics",
    "data_categories": ["App info and performance", "Device or other IDs"],
    "risk": "crash_reporting"
  },
  "sentry": {
    "patterns": ["sentry", "@sentry/react-native", "@sentry/browser", "@sentry/node"],
    "category": "crash_reporting",
    "third_party": "Sentry",
    "data_categories": ["App info and performance", "Device or other IDs"],
    "risk": "crash_reporting"
  },
  "revenuecat": {
    "patterns": ["revenuecat", "react-native-purchases", "purchases-ios", "purchases-android"],
    "category": "subscription",
    "third_party": "RevenueCat",
    "data_categories": ["Financial info", "Personal info", "Device or other IDs"],
    "risk": "payment_or_subscription"
  },
  "admob": {
    "patterns": ["admob", "google-mobile-ads", "react-native-google-mobile-ads", "play-services-ads"],
